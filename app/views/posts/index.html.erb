<h1>タイムライン</h1>

<% if authenticated? %>
  <% if @post.errors.any? %>
    <ul class="errors">
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: @post do |form| %>
    <div><%= form.label :body %><%= form.text_area :body %></div>
    <%= form.submit "投稿する" %>
  <% end %>
<% end %>

<%= render @posts %>
