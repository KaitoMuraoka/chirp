<h1>ユーザー登録</h1>

<% if @user.errors.any? %>
  <ul style="color:red">
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user, url: registration_path do |form| %>
  <div><%= form.label :name %><br><%= form.text_field :name, required: true, autofocus: true %></div>
  <div><%= form.label :email_address %><br><%= form.email_field :email_address, required: true, autocomplete: "username" %></div>
  <div><%= form.label :password %><br><%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %></div>
  <div><%= form.label :password_confirmation %><br><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %></div>
  <%= form.submit "登録する" %>
<% end %>
